---
import { PROJECTS } from "@/lib/data";
---

<section class="group flex flex-col gap-y-2">
	<h1 class="max-sm:text-md font-heading text-md text-left">Projects</h1>

	<div>
		{
			PROJECTS.map((project) => (
				<div class="text-foreground mb-6 opacity-100 transition-opacity duration-150 ease-in-out group-hover:opacity-45 hover:opacity-100!">
					<a
						class="mb-1 font-light decoration-blue-400 decoration-wavy decoration-2 underline-offset-2 hover:underline dark:decoration-blue-300"
						href={project.url || project.repo}
						target="_blank"
					>
						{project.name}
					</a>
					<p class="text-muted mb-1 leading-relaxed">
						{project.description}
					</p>
				</div>
			))
		}
	</div>
</section>
